# Local run only (`pnpm dev`). On LiveKit Cloud, LIVEKIT_URL / LIVEKIT_API_KEY /
# LIVEKIT_API_SECRET are injected for you; set the rest with `lk agent update-secrets`.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Same values as in the app's .env
CLASSROOM_AGENT_NAME=spanglish-classroom
CLASSROOM_AGENT_SECRET=
# Where the app runs (the agent posts transcript lines there)
SPANGLISH_APP_URL=https://your-domain.com

# Optional: another LiveKit Inference speech-to-text model or language
# STT_MODEL=deepgram/nova-3
# STT_LANGUAGE=multi

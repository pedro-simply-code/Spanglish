{
  "name": "spanglish",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env --require ./scripts/server-only-shim.cjs scripts/seed.ts",
    "db:reset": "tsx --env-file=.env --require ./scripts/server-only-shim.cjs scripts/reset-db.ts",
    "admin:promote": "tsx --env-file=.env --require ./scripts/server-only-shim.cjs scripts/promote-admin.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:recordings": "tsx --env-file=.env --require ./scripts/server-only-shim.cjs scripts/check-recordings.ts",
    "b2:cors": "tsx --env-file=.env --require ./scripts/server-only-shim.cjs scripts/b2-cors.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@livekit/protocol": "1.53.0",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@mui/x-date-pickers": "^9.18.0",
    "@neondatabase/serverless": "^1.2.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.51.0",
    "apexcharts": "^4.7.0",
    "better-auth": "1.7.25",
    "date-fns": "^2.30.0",
    "drizzle-orm": "^0.45.4",
    "livekit-client": "^2.24.1",
    "livekit-server-sdk": "^2.19.3",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "nodemailer": "^10.5.0",
    "notistack": "^3.0.2",
    "postmark": "^5.1.1",
    "react": "19.3.0",
    "react-apexcharts": "^1.9.0",
    "react-big-calendar": "^1.20.0",
    "react-dom": "19.3.0",
    "react-qr-code": "2.2.0",
    "simplebar-react": "^3.3.2",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}

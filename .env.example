# Copy this file to `.env` and fill in the values.
# Do not commit secrets: `.env` is gitignored.

# Next.js sets NODE_ENV during dev/build; only set this if you need to override it.
# NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host:5432/spanglish
# After setting DATABASE_URL, run: npm run db:migrate && npm run db:seed
# Use migrations, not db:push: the no-double-booking constraint is a custom
# migration that db:push cannot create.
# The seed (development only) adds demo users, pricing packages, teacher
# availability, two student pairs, credits and sample classes.
# Start from an empty database (demo data only, deletes everything):
# npm run db:reset -- --yes && npm run db:migrate && npm run db:seed
# Demo accounts (password Spanglish1!): student, student2…10, teacher, teacher2…5,
# manager, manager2 @spanglish.academy. No demo admin: see ADMIN_EMAIL.
# They are listed on the login page only on a dev server or with this flag
# (staging only — never on the public site):
# ENABLE_DEMO_ACCOUNTS=false

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Better Auth: signs session cookies and encrypts 2FA secrets. Min. 32 characters.
# Required in production (local dev uses a built-in fallback if unset).
#
# Generate once; keep the same value across deploys (changing it invalidates sessions):
#   openssl rand -base64 32
#   # or: openssl rand -hex 32
#
# Vercel: Settings → Environment Variables → BETTER_AUTH_SECRET (Production + Preview).
#
# BETTER_AUTH_SECRET=
#
# Classroom / guest-join tokens (separate secret; do not reuse BETTER_AUTH_SECRET).
#   openssl rand -base64 32
# AUTH_SECRET=
# The academy owner: the only admin. Put just the email here (never a
# password). Sign up with it on the site (Google, email code, or email +
# password); once the email is verified, the account becomes the admin. Any
# other account loses the admin role.
# Without it, use `npm run admin:promote -- you@example.com`.
# ADMIN_EMAIL=you@example.com
# Optional cookie name for the active-dashboard preference (default shown):
# AUTH_DASHBOARD_COOKIE=spanglish_dashboard

# ---------------------------------------------------------------------------
# Email (verification codes and class notifications)
# ---------------------------------------------------------------------------
# EMAIL_PROVIDER=gmail_smtp
# EMAIL_FROM="Spanglish <you@gmail.com>"
# Lifetime of email codes (sign-in, verification, password reset), in minutes.
# Without email delivery, `npm run dev` prints the codes in the server terminal.
# EMAIL_CODE_TTL_MINUTES=10
#
# Gmail SMTP (default) — use an App Password, not your normal password:
# https://support.google.com/accounts/answer/185833
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
#
# Postmark (switch when ready):
# EMAIL_PROVIDER=postmark
# POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# POSTMARK_MESSAGE_STREAM=outbound
# Bounce / spam-complaint webhook (stops emails to dead addresses). Random,
# 16+ characters. In Postmark → Servers → Webhooks add the URL
#   https://postmark:<POSTMARK_WEBHOOK_SECRET>@<your-domain>/api/webhooks/postmark
# and tick "Bounce" and "Spam complaint". Without it the endpoint answers 401.
# POSTMARK_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
#   e.g. http://localhost:3000/api/auth/callback/google
# The Google button is hidden until both values are set (restart the dev
# server after editing .env). AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET also work.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Android app (later): OAuth client of type "Android". Its id tokens are
# accepted by POST /api/auth/sign-in/social with { provider: "google", idToken }.
# GOOGLE_ANDROID_CLIENT_ID=

# ---------------------------------------------------------------------------
# Bot protection: Cloudflare Turnstile (optional) — https://dash.cloudflare.com/?to=/:account/turnstile
# ---------------------------------------------------------------------------
# Protects sign-up, "email me a code" and password reset. Off until both are set.
# Add localhost and your domain to the widget's hostnames.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Live classes: LiveKit (video only) — https://livekit.io/cloud
# ---------------------------------------------------------------------------
# MEETING_PROVIDER=livekit
# Project settings → Keys in the LiveKit Cloud dashboard
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# WebSocket URL, e.g. wss://your-project.livekit.cloud
# LIVEKIT_URL=wss://your-project.livekit.cloud
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# MEETING_TOKEN_TTL_MINUTES=60
# CLASS_WAITING_ROOM=false
# Only the assigned teacher can open the LiveKit call; students wait until start (default true).
# CLASS_TEACHER_STARTS_SESSION=true
# LIVEKIT_RTMP_URL=rtmps://a.rtmp.youtube.com/live2/your-stream-key
# Attendance and finished recordings: LiveKit Cloud → Settings → Webhooks →
#   https://<your-domain>/api/webhooks/livekit  (signed with the API key above)
# LiveKit SIP / telephony is configured in the LiveKit Cloud dashboard (enterprise).
# Live transcription: the classroom agent (agent/, see agent/README.md) joins each
# class and transcribes every participant with Deepgram Nova-3 (multilingual) through
# LiveKit Inference, billed to the LiveKit Cloud project. Same name as the agent's.
# CLASSROOM_AGENT_NAME=spanglish-classroom
# Shared with the agent; it sends the transcript lines to /api/agent/transcript.
# CLASSROOM_AGENT_SECRET=  (32+ random characters, e.g. openssl rand -hex 32)
# Claude summarizes each class from its transcript when it ends (needs ANTHROPIC_API_KEY).
# LESSON_SUMMARY_ENABLED=true

# ---------------------------------------------------------------------------
# Class recordings: Backblaze B2 — https://www.backblaze.com/b2/cloud-storage.html
# ---------------------------------------------------------------------------
# Create an Application Key with read/write on your bucket; enable S3-compatible API.
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_NAME=spanglish-recordings
# S3-compatible endpoint (https:// required — or host only, env.ts adds https://)
# B2_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
#
# Where to persist recordings after you stop recording:
# - local (default): browser download + files under storage/recordings/ on the server
# - cloud: the teacher's browser uploads straight to B2 with a signed URL.
#   Add a CORS rule to the bucket allowing PUT from your site's origin.
# Unset: B2 when the B2_* variables are set, otherwise local disk.
# RECORDING_STORAGE=local

# ---------------------------------------------------------------------------
# Live classes: student policy (enforced on the server)
# ---------------------------------------------------------------------------
# CLASS_CANCEL_CUTOFF_HOURS=24
# CLASS_RESCHEDULE_CUTOFF_HOURS=24
# CLASS_JOIN_WINDOW_BEFORE_MINUTES=15
# CLASS_JOIN_WINDOW_AFTER_MINUTES=15
# Booleans accept true/false (also 1/0, yes/no, on/off).
# Testing only: open the classroom before the usual join window.
# CLASS_RELAX_JOIN_WINDOW=false

# ---------------------------------------------------------------------------
# Client (must use NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------
# Public site URL (OAuth redirects, emails, Stripe return URLs).
# Local: http://localhost:3000
# Vercel: set this in Project → Settings → Environment Variables for Production
# (and Preview if you test Google there), e.g. https://your-project.vercel.app
# — NOT localhost, or Google will send users back to your machine (state_mismatch).
# After changing it on Vercel, redeploy. Google Console needs the matching redirect:
#   https://<your-domain>/api/auth/callback/google
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Stripe (payments in, teacher payouts out)
# ---------------------------------------------------------------------------
# Dashboard → Developers → API keys, in TEST mode (sandbox): sk_test_...
# Without a key, checkout stays a demo purchase. Live keys (sk_live_) are
# ignored unless STRIPE_ALLOW_LIVE=true.
# STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://<domain>/api/webhooks/stripe
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.expired, account.updated incl. connected accounts).
# Locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# prints the whsec_ secret to use here.
# STRIPE_WEBHOOK_SECRET=
# Country of teachers' Connect (Express) accounts. Default US.
# STRIPE_CONNECT_COUNTRY=US
# STRIPE_ALLOW_LIVE=false
# Typical time teachers see for review + funds reaching their bank (business days).
# PAYOUT_PROCESSING_BUSINESS_DAYS=5

# ---------------------------------------------------------------------------
# AI conversation practice (Anthropic Claude) — student "Study → Talk with AI"
# ---------------------------------------------------------------------------
# console.anthropic.com → API keys. Without a key the tab explains it is off.
# ANTHROPIC_API_KEY=
# Model id; the default is the cheapest current Claude model.
# ANTHROPIC_MODEL=claude-haiku-5-5
# Only for development/tests: a fake Claude server instead of the real API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Token budget per conversation (input + output, including the scene drawing).
# Also the size of 1 AI credit: changing it updates the packs and every screen.
# AI_CONVERSATION_TOKEN_LIMIT=10000
# Model price in USD per million tokens (input / output), to show what each
# conversation cost. Update when you change ANTHROPIC_MODEL.
# AI_PRICE_INPUT_PER_MTOK=0.10
# AI_PRICE_OUTPUT_PER_MTOK=0.50
# Each attended class gives this many free conversations with Luna and the same
# number in the chat; after that each new conversation spends 1 AI credit
# (packs on sale in admin → pricing).
# AI_FREE_CONVERSATIONS_PER_CLASS=2
# Optional safety cap on new conversations per day and practice (0 = no cap).
# AI_CONVERSATIONS_PER_DAY=0
# AI credit packs (1 credit = 1 conversation of AI_CONVERSATION_TOKEN_LIMIT tokens).
# Admin sets each pack's price and margin; the conversations it gives are
#   (price − card fee − margin) ÷ (tokens per conversation × USD per M tokens ÷ 1M × multiplier)
# so changing any of these updates every pack. Model price, mixed input/output:
# AI_CREDIT_USD_PER_MTOK=0.30
# Each conversation is priced at this many times its model cost (2 = double).
# AI_CREDIT_COST_MULTIPLIER=2
# Card fee of the payment provider (Stripe US: 2.9% + 30¢).
# PAYMENT_FEE_PERCENT=2.9
# PAYMENT_FEE_FIXED_CENTS=30

# ---------------------------------------------------------------------------
# Development only: pretend "now" is this moment (ISO date with time zone),
# e.g. to see a class as "live now". The database is not changed; production
# ignores it. Remove it (or leave it empty) to use the real clock.
# APP_NOW_OVERRIDE=2026-11-27T18:05:00-06:00

# ---------------------------------------------------------------------------
# Scheduled jobs. Set a long random value and have your host call, every hour:
#   GET /api/cron/reconcile-payments   with   Authorization: Bearer <CRON_SECRET>
# It settles Stripe payments left "pending" (missed webhook): paid → credits
# added, expired → canceled. On Vercel, add to vercel.json:
#   { "crons": [{ "path": "/api/cron/reconcile-payments", "schedule": "0 * * * *" }] }
# (Vercel sends the header by itself when CRON_SECRET is set.)
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Error monitoring: Sentry (optional, free plan) — https://sentry.io
# ---------------------------------------------------------------------------
# Create a Next.js project in Sentry and copy its DSN (Settings → Client Keys).
# Off while empty. Set alerts in Sentry for Stripe webhooks, Claude, LiveKit.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
